# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# LAN appliance whose address moves under DHCP? Set both of these to True
# instead of maintaining ALLOWED_HOSTS/CORS_ALLOWED_ORIGINS by hand — trusts
# any Host/Origin that's a private IP (10.x, 172.16-31.x, 192.168.x) or
# loopback. Off by default; a known/stable domain should use the explicit
# lists above instead.
ALLOW_PRIVATE_NETWORK_HOSTS=False
CORS_ALLOW_PRIVATE_NETWORKS=False

# JWT signing key — set this to a DIFFERENT random value than SECRET_KEY.
# SECRET_KEY also signs Django sessions/CSRF/password-reset tokens; sharing
# it with JWT means any exposure of one lets an attacker forge the other.
# Falls back to SECRET_KEY if left unset (backward-compat only — set it).
JWT_SIGNING_KEY=your-jwt-signing-key-here-different-from-secret-key

# Database
DB_NAME=netvault
DB_USER=netvault_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=3306

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440
JWT_ALGORITHM=HS256

# Encryption Key for device credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-encryption-key-here

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# WebAuthn (passkeys) — an alternative/additional 2FA factor to TOTP.
# Requires HTTPS and a real domain (browsers refuse WebAuthn over plain
# HTTP or a bare IP address, `localhost` excepted). WEBAUTHN_RP_ID must be
# exactly the domain shown in the browser's address bar, no scheme/port —
# defaults to the hostname of the first CORS_ALLOWED_ORIGINS entry above if
# left unset, which is usually already correct. Leave both unset if this
# deployment is only reachable over HTTP/LAN IP — the feature quietly
# won't offer itself in that case.
# WEBAUTHN_RP_ID=netvault.example.com
# WEBAUTHN_RP_NAME=NetVault

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# LDAP Settings (optional)
LDAP_SERVER_URI=ldap://your-ldap-server.com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-password
LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Timezone (OPTIONAL - auto-detects from system /etc/timezone if not set)
# Only set this if you want to override the system timezone
# Examples: UTC, Europe/Moscow, Asia/Almaty, Asia/Yekaterinburg, Asia/Tashkent
# List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# TIME_ZONE=UTC

# Security
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
